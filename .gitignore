node_modules/
.turbo/
dist/
.next/
out/
coverage/
.env
.env.*
!.env.example
!.env.production.example
.expo/
*.tsbuildinfo
.DS_Store
apps/bff/uploads/*
!apps/bff/uploads/.gitkeep

# Generated by prisma/seedDemoListings.ts — root-relative photo URLs served straight out of
# this dir locally (no R2/CDN needed for demo data). Regeneratable, not app source.
apps/web/public/photos/*
!apps/web/public/photos/.gitkeep

# Design handoff reference material, not app source
Real Estate Marketplace Platform.zip
Bhavano icon design.zip

# Claude Code per-user local settings (permissions etc.) — machine-specific, not shared
.claude/settings.local.json

# Playwright smoke suite (apps/web/e2e) — local run artifacts, not app source
apps/web/e2e/.auth/
apps/web/playwright-report/
apps/web/test-results/

# Payment provider keys — never commit; rotate immediately if this was ever pushed
rzp-key.csv

# Locally generated Caddy root CA (machine-specific, regenerated per dev box)
caddy-local-root.crt

# Python (the gtm_*.py / *_audit.py admin scripts at the repo root)
__pycache__/
*.pyc

# Agent skill packs installed by `npx skills add` (e.g. expo/skills). Machine-local and
# regenerable, so not shared — but the real reason they must be ignored is that `.claude/skills`
# is a tree of symlinks into `.agents/skills`, and EAS Build copies untracked-but-unignored files
# into its clone, where Windows refuses to recreate a symlink. That fails the upload with
# "EPERM: operation not permitted, symlink ...". Reinstall with `npx skills@latest add`.
.agents/
**/.claude/skills/
