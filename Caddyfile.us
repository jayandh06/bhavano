# Caddy for the US host (docker-compose.us.yml). Names set in .env:
#   US_ORIGIN_DOMAIN  where India's Caddy sends www.bhavano.com/us/* (caddy/market-routes/us.caddy); visitors never use it directly.
#   US_API_DOMAIN     the US API (NEXT_PUBLIC_BFF_URL of the US web image).
#   US_ADMIN_DOMAIN   the US admin site; optional (the compose file supplies an unreachable name when it is not set).
# Same HSTS rule as India's Caddyfile: one year, no includeSubDomains or preload.
{
	servers {
		# India's Caddy (www.bhavano.com) forwards /us to this host. Trusting it keeps the X-Forwarded-For, -Proto and -Host it sends (the
		# visitor's address, https, and www.bhavano.com). Without this, this Caddy overwrites them with its own view (us-origin), and Next.js
		# refuses every Server Action because x-forwarded-host (us-origin) does not match the browser's Origin (www). Its address is
		# India's Elastic IP; override with INDIA_PROXY_IP in .env if that host ever moves.
		trusted_proxies static {$INDIA_PROXY_IP:13.205.0.54}
	}
}

(hsts) {
	header Strict-Transport-Security "max-age=31536000"
}

{$US_ORIGIN_DOMAIN} {
	import hsts
	# Not indexable until the US launches: the header covers every response (assets, redirects, errors), the page
	# meta tag (apps/web/src/lib/marketRobots.ts) covers the HTML. Launch: set US_ROBOTS_TAG=all in .env (and flip
	# `indexable` for the US in packages/types/src/market.ts).
	header X-Robots-Tag "{$US_ROBOTS_TAG:noindex, nofollow}"
	# The US web app is built with basePath /us, so it expects the /us prefix India's Caddy forwards as is.
	reverse_proxy web:3000
}

{$US_API_DOMAIN} {
	request_body {
		max_size 210MB
	}
	reverse_proxy bff:4000
}

# The US admin site, on its own name like India's. Never indexed.
{$US_ADMIN_DOMAIN} {
	import hsts
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy admin:3001
}
