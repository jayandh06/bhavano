EXPO_PUBLIC_BFF_URL=http://localhost:4000
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Google Maps SDK (Android) — leave blank locally; the posting flow's map pin-picker won't
# render on Android until set (see docs/plans/google-maps-location-picker.md). iOS needs no
# equivalent key — it uses Apple Maps by default. Read by app.config.js's react-native-maps
# plugin entry, not by app code directly.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=

# Public web origin, used for the in-app legal/entity links on the Account tab.
EXPO_PUBLIC_SITE_URL=https://bhavano.com

# SDK 57 installs expo/fetch as the global fetch, whose FormData handling only accepts
# string|Blob parts — it rejects React Native's classic { uri, name, type } file-upload shape
# with "Unsupported FormDataPart implementation" (thrown from bffClient.ts's uploadPhoto/
# uploadVideo, i.e. any photo/video attached while posting an ad). This keeps RN's built-in
# fetch as the global instead, which does support that shape. Required — do not remove until
# uploadPhoto/uploadVideo are rewritten against a real Blob (expo-file-system's File class).
# See https://docs.expo.dev/versions/latest/sdk/expo/#expofetch-api.
EXPO_PUBLIC_USE_RN_FETCH=1
