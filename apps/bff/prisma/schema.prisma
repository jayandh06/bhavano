generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ListingCategory {
  house
  apartment
  villa
  pg
  storage
  coworking
  furniture
  interiors
  plot
  commercial
}

enum TransactionType {
  buy
  sell
  rent
  lease
}

enum ListingStatus {
  active
  sold
  rented
  deactivated
}

enum ListingCondition {
  new
  used
}

enum UserRole {
  user
  admin
}

/** approved = normal/visible; flagged = an admin took it offline pending a fix from the
 * owner (this IS the soft-delete — there's no separate deleted state). */
enum ModerationState {
  approved
  flagged
}

/** inquiry = buyer/seller chat about a listing; moderation = admin↔owner thread about a
 * flagged listing. Kept distinct so an admin's thread can't collide with a real buyer's. */
enum ConversationType {
  inquiry
  moderation
}

enum LoginMethod {
  otp
  google
}

enum RateLimitKind {
  publish
  view
}

enum PaymentStatus {
  created
  paid
  failed
  refunded
}

enum PaymentPurpose {
  listing_boost
  buyer_premium
  agent_pro
  seller_slot_pack
}

enum SubscriptionTier {
  buyerPremium
  agentPro
  sellerSlotPack
}

/** Where an outreach contact came from — kept as provenance so a bad import batch can be
 * identified and undone. See docs/plans/outreach-campaign-contacts.md. */
enum ContactSource {
  google_maps
  scrape
  manual_upload
  referral
}

enum ContactStatus {
  new
  enriched
  contacted
  engaged
  converted
  invalid
  bounced
}

/** Consent basis for contacting someone. `opted_out` is terminal — the send path refuses it,
 * and a matching SuppressionEntry keeps the opt-out alive even if the contact row is deleted
 * and re-imported by a later scrape. */
enum ConsentState {
  none
  implied
  explicit
  opted_out
}

enum OutreachChannel {
  sms
  whatsapp
  email
}

enum CampaignStatus {
  draft
  scheduled
  running
  paused
  completed
}

enum SendStatus {
  queued
  sent
  delivered
  failed
  suppressed
  opted_out
}

model City {
  id        String    @id @default(cuid())
  name      String
  state     String
  lat       Float
  lng       Float
  isPopular Boolean   @default(false)
  source    String    @default("curated")
  listings  Listing[]
  areas     Area[]
  users     User[]
  savedSearches SavedSearch[]
  outreachContacts OutreachContact[]

  @@unique([name, state])
}

model Area {
  id       String    @id @default(cuid())
  name     String
  cityId   String
  city     City      @relation(fields: [cityId], references: [id])
  lat      Float?
  lng      Float?
  source   String    @default("curated")
  listings Listing[]
  savedSearches SavedSearch[]
  outreachContacts OutreachContact[]

  @@unique([name, cityId])
  @@index([cityId])
}

model User {
  id                    String         @id @default(cuid())
  phone                 String?        @unique
  phoneVerifiedAt       DateTime?
  email                 String?        @unique
  /** Non-null once the address was actually proven — set by Google sign-in (Google asserts it)
   * or by completing the emailed-code flow. An email typed into the profile form stays null:
   * useful for reaching the user, but NOT evidence of identity, so account adoption in
   * loginWithGoogle keys on this rather than on `email`. See
   * docs/plans/account-linking-phone-and-email.md. */
  emailVerifiedAt       DateTime?
  googleId              String?        @unique
  name                  String?
  role                  UserRole       @default(user)
  cityId                String?
  city                  City?          @relation(fields: [cityId], references: [id])
  createdAt             DateTime       @default(now())
  /** Non-null once the first-login welcome email/SMS/WhatsApp has been dispatched — gates
   * AuthService from sending it again. Backfilled to createdAt for pre-existing users so they
   * don't retroactively get a "Welcome!" message. */
  welcomedAt            DateTime?
  listings              Listing[]
  favourites            Favourite[]
  conversationsAsPoster Conversation[] @relation("ConversationPoster")
  conversationsAsInquirer Conversation[] @relation("ConversationInquirer")
  messages              Message[]
  loginEvents           LoginEvent[]
  payments              Payment[]
  subscriptions         UserSubscription[]
  savedSearches         SavedSearch[]
  /** Denormalized from the latest active UserSubscription (tier: buyerPremium) — cheap reads
   * everywhere else in the app (header/messaging badge, profile page); UserSubscription is
   * the audit trail. Null means never subscribed or lapsed. */
  premiumUntil          DateTime?
  /** Same denormalization for tier: agentPro — listing slot allowance + storefront badge. */
  agentProUntil         DateTime?
  /** Stacked Agent Pro blocks (each ₹499/month → +20 slots) while agentProUntil is active. */
  agentProUnits         Int            @default(1)
  /** Denormalized seller add-on (10 concurrent slots) — see sellerSlotPack subscription tier. */
  sellerSlotPackUntil   DateTime?
  proBoostCredits       ProBoostCredit[]
  /** First-touch attribution: the UTM source/medium/campaign of the link the user first landed
   * on, or the external Referer hostname with medium "referral" if untagged, or source "direct"
   * if neither was present. Captured by apps/web's middleware.ts on the user's very first visit
   * and written here only when this row is first created (see AuthService.verifyOtp /
   * loginWithGoogle) — never overwritten afterward, so it reflects how the user originally found
   * Bhavano rather than the source of their most recent login. */
  acquisitionSource     String?
  acquisitionMedium     String?
  acquisitionCampaign   String?
  visits                Visit[]
  /** Set when this user was first reached as an outreach prospect — the attribution link back
   * to a campaign. Null for organic signups. */
  outreachContact       OutreachContact?
  outreachCampaigns     OutreachCampaign[]
  supportTickets        SupportTicket[]
  /** Non-null once this account was merged into another — the row is kept, never deleted, so the
   * payments and listings that used to hang off it stay auditable and a bad merge stays
   * recoverable. Points at the survivor rather than being a bare `deletedAt` so support can
   * follow the chain. Sessions for a merged row resolve to the survivor (see AuthGuard).
   * See docs/plans/account-linking-phone-and-email.md. */
  mergedIntoUserId      String?
  mergedInto            User?          @relation("UserMerge", fields: [mergedIntoUserId], references: [id])
  mergedFrom            User[]         @relation("UserMerge")
  mergedAt              DateTime?
  /** phone/email/googleId are @unique, so a retained row would keep holding the identifiers the
   * surviving account needs — which is the entire point of merging. They are released (nulled)
   * and preserved here instead. */
  mergedPhone           String?
  mergedEmail           String?
  /** Non-null once the user deleted their own account. The row survives — it is the audit trail
   * behind their payments — but every identifying field is cleared and the identifiers released,
   * so the account is unusable and holds no personal data. Required by App Store guideline
   * 5.1.1(v) and by the DPDP Act's erasure right; see docs/plans/ios-app-store-release.md. */
  deletedAt             DateTime?

  @@index([cityId])
  @@index([mergedIntoUserId])
  @@index([deletedAt])
}

model Listing {
  id               String            @id @default(cuid())
  category         ListingCategory
  transactionType  TransactionType
  status           ListingStatus     @default(active)
  moderationState  ModerationState   @default(approved)
  adminReviewed    Boolean           @default(false)
  moderatedAt      DateTime?
  condition        ListingCondition?
  price            Int
  priceQualifier   String            @default("")
  title            String
  slug             String
  areaId           String
  area             Area              @relation(fields: [areaId], references: [id])
  cityId           String
  city             City              @relation(fields: [cityId], references: [id])
  lat              Float?
  lng              Float?
  tag              String
  specs            String[]          @default([])
  attributes       Json              @default("{}")
  ownerId          String
  owner            User              @relation(fields: [ownerId], references: [id])
  relatedListingId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  expiresAt        DateTime
  viewCount        Int               @default(0)
  likeCount        Int               @default(0)
  // Denormalized from ListingBoost (the audit trail) so the hot-path browse query never needs
  // a join just to check boost status — null means not currently boosted. boostRank is bumped
  // by a periodic job to rotate tie-order among simultaneously-boosted listings, rather than
  // whoever paid first/most permanently squatting the top slot.
  boostedUntil     DateTime?
  boostRank        Float?
  listingPhotos    ListingPhoto[]
  listingVideos    ListingVideo[]
  views            ListingView[]
  favourites       Favourite[]
  conversations    Conversation[]
  payments         Payment[]
  listingBoosts    ListingBoost[]
  notificationLogs ListingNotificationLog[]
  listingRenewals  ListingRenewal[]

  @@index([cityId, category])
  @@index([cityId, transactionType])
  @@index([expiresAt])
  @@index([boostedUntil])
  @@index([ownerId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([areaId])
}

/** One row per unique viewer (logged-in user id or anonymous device key) — used to
 * dedupe Listing.viewCount so repeat visits from the same viewer don't inflate it. */
model ListingView {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  viewerKey String
  createdAt DateTime @default(now())

  @@unique([listingId, viewerKey])
  @@index([viewerKey])
}

model Favourite {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([listingId, userId])
}

/** Bhavano Plus's early-access alerts — a Plus-gated buyer sets criteria here, and every
 * newly-created listing matching them fires a notification immediately (see
 * ListingsService.create() -> SavedSearchesService.notifyMatchingBuyers), instead of the buyer
 * having to keep re-checking browse pages themselves. All filter fields are optional/nullable —
 * an unset field means "don't filter on this", not "must be null". */
model SavedSearch {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  name            String
  category        ListingCategory?
  transactionType TransactionType?
  cityId          String?
  city            City?            @relation(fields: [cityId], references: [id])
  areaId          String?
  area            Area?            @relation(fields: [areaId], references: [id])
  minPrice        Int?
  maxPrice        Int?
  bedrooms        Int?
  createdAt       DateTime         @default(now())
  lastNotifiedAt  DateTime?

  @@index([userId])
}

model Conversation {
  id          String           @id @default(cuid())
  listingId   String
  listing     Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  posterId    String
  poster      User             @relation("ConversationPoster", fields: [posterId], references: [id])
  inquirerId  String
  inquirer    User             @relation("ConversationInquirer", fields: [inquirerId], references: [id])
  type        ConversationType @default(inquiry)
  createdAt   DateTime         @default(now())
  messages    Message[]

  @@unique([listingId, inquirerId, type])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId, createdAt])
}

/** One row per photo on a listing — ordered by photoNo, hash retained for the existing
 * near-duplicate check at moderation time. Variant URLs (preview/full) are never stored
 * here; they're fully derived from listingId + photoNo (see apps/bff/src/uploads/photo-keys.ts). */
model ListingPhoto {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  photoNo   Int
  hash      String
  createdAt DateTime @default(now())

  @@unique([listingId, photoNo])
  @@index([hash])
}

enum PhotoVariantType {
  preview
  full
}

enum PhotoJobStatus {
  pending
  processing
  done
  failed
}

/** Durable work queue for async photo resizing — polled in-process (no Redis/queue infra).
 * No FK to Listing: jobs are only created once the listing already exists (from
 * ListingsService.create(), not from the upload step, which runs before the listing does). */
model PhotoVariantJob {
  id        String           @id @default(cuid())
  listingId String
  photoNo   Int
  ext       String
  variant   PhotoVariantType
  status    PhotoJobStatus   @default(pending)
  attempts  Int              @default(0)
  error     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status, createdAt])
}

enum VideoStatus {
  pending
  processing
  done
  failed
}

/** One uploaded video per row, carrying its own processing state — deliberately NOT split into a
 * separate job table the way ListingPhoto/PhotoVariantJob are. That split exists for photos
 * because the upload step runs before the listing exists; every video attach path (the wizard, or
 * the post-creation add-video endpoint) runs after the Listing row already exists, so there's
 * nothing to decouple — and splitting would mean downloading + decoding the (large) original once
 * per output variant instead of once. See docs/plans/listing-video-uploads.md. */
model ListingVideo {
  id        String      @id @default(cuid())
  listingId String
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  /** Display order only — never appears in a storage key, so reusing a videoNo after a delete
   * (e.g. via `max(videoNo)+1`) is harmless. */
  videoNo   Int
  /** Opaque, server-minted, the ONLY identifier in the R2 key (see video-keys.ts) — keeps keys
   * write-once even though videos are deletable, so a delete + re-add can never resolve to a key
   * Cloudflare's edge cache still has a stale copy of (there's no app-level cache-purge hook). */
  storageId String      @unique
  ext       String
  /** ffprobe-verified server-side, never client-reported — this is the tier-enforcement value. */
  durationSec Int
  sizeBytes Int
  status    VideoStatus @default(pending)
  attempts  Int         @default(0)
  error     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([listingId, videoNo])
  @@index([status, createdAt])
  @@index([listingId])
}

/** Emailed verification codes, mirroring OtpChallenge for phone. Scoped to a user because an
 * email is only ever verified from inside a logged-in session — there is no email login. */
model EmailChallenge {
  id        String   @id @default(cuid())
  userId    String
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model OtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

model LoginEvent {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  method    LoginMethod
  createdAt DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/** One row per browser session (not per page load) — apps/web's middleware.ts fires this the
 * first time it sees a request without a `bhavano_sid` cookie, i.e. once per "sitting" (a new
 * session starts after the browser/tab is closed and reopened). `userId` starts null for an
 * anonymous visitor and is filled in later by AuthService if that same session goes on to log in
 * — never reattributed once set. Distinct from `User.acquisition*` (a permanent, 30-day-cookie
 * first-ever-touch summary): this is the full per-session audit log, covering every visit
 * including ones that never convert to a signup. */
model Visit {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  source      String?
  medium      String?
  campaign    String?
  landingPath String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/** One row per rate-limited action attempt, counted over a rolling window at check time —
 * not pruned (same non-cleanup precedent as OtpChallenge). Anonymous requests never reach
 * the guard that writes these, so `identity` is always "user:<id>". */
model RateLimitHit {
  id        String        @id @default(cuid())
  identity  String
  kind      RateLimitKind
  createdAt DateTime      @default(now())

  @@index([identity, kind, createdAt])
}

/** Singleton row (fixed id "singleton", upserted) — the admin-editable rate limits. */
model RateLimitSetting {
  id                   String   @id
  publishLimit         Int      @default(5)
  publishWindowMinutes Int      @default(1440)
  viewLimit            Int      @default(200)
  viewWindowMinutes    Int      @default(60)
  updatedAt            DateTime @updatedAt
}

/** Central payment ledger — the single source of truth for whether a purchase actually
 * succeeded. The Razorpay webhook (never a client-side "payment succeeded" callback) is what
 * flips a row to `paid`; `razorpayPaymentId` is unique so webhook redelivery is always a safe
 * no-op. `listingId`/`boostDays` are purpose-specific fields (only meaningful for
 * `listing_boost`) — left nullable rather than modeled generically, same pattern as
 * `Listing.condition` being furniture-only; future purposes add their own nullable fields in
 * their own migration instead of retrofitting a generic column now. */
model Payment {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id])
  razorpayOrderId   String         @unique
  razorpayPaymentId String?        @unique
  amount            Int
  currency          String         @default("INR")
  status            PaymentStatus  @default(created)
  purpose           PaymentPurpose
  listingId         String?
  listing           Listing?       @relation(fields: [listingId], references: [id])
  boostDays         Int?
  /** Only meaningful for buyer_premium/agent_pro — same "purpose-specific nullable field"
   * convention as boostDays above. */
  subscriptionMonths Int?
  /** agent_pro orders only — number of ₹499 blocks purchased (20 slots each). */
  agentProUnits     Int?
  createdAt         DateTime       @default(now())
  paidAt            DateTime?
  listingBoost      ListingBoost?
  subscription      UserSubscription?

  @@index([userId, createdAt])
}

/** One row per activated buyer_premium/agent_pro purchase — the audit trail; User.premiumUntil/
 * agentProUntil are the cheap denormalized reads used everywhere else (same pattern as
 * ListingBoost/Listing.boostedUntil below). */
model UserSubscription {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  tier      SubscriptionTier
  startsAt  DateTime         @default(now())
  endsAt    DateTime
  paymentId String           @unique
  payment   Payment          @relation(fields: [paymentId], references: [id])

  @@index([userId])
}

/** One row per activated boost — the history/audit trail. `Listing.boostedUntil` is the
 * denormalized field the hot-path browse query actually reads, kept in sync here so listing
 * queries never need a join just to check boost status. */
model ListingBoost {
  id           String   @id @default(cuid())
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  paymentId    String   @unique
  payment      Payment  @relation(fields: [paymentId], references: [id])
  boostedFrom  DateTime @default(now())
  boostedUntil DateTime

  @@index([listingId])
}

/** One row per renewal — the audit trail for "how many times, and from what date to what date"
 * a listing was renewed. See docs/plans/finish-listing-renewal-ui-and-history.md. */
model ListingRenewal {
  id                String   @id @default(cuid())
  listingId         String
  listing           Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  previousExpiresAt DateTime
  newExpiresAt      DateTime
  renewedAt         DateTime @default(now())

  @@index([listingId])
}

/** Idempotent send log for listing expiry reminders (7d / 1d before expiresAt). */
model ListingNotificationLog {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  kind      String
  channel   String
  sentAt    DateTime @default(now())

  @@unique([listingId, kind])
  @@index([sentAt])
}

/** One unredeemed row per Agent Pro user per calendar month (UTC) — 7-day boost credit. */
model ProBoostCredit {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthKey   String
  redeemedAt DateTime?
  listingId  String?
  createdAt  DateTime  @default(now())

  @@unique([userId, monthKey])
}

/// ---------------------------------------------------------------------------
/// Outreach / marketing campaigns — see docs/plans/outreach-campaign-contacts.md
/// ---------------------------------------------------------------------------

/** A prospective customer sourced externally (Google Maps, scraping, CSV upload) — deliberately
 * NOT a User row: these never authenticate, and mixing them into User would leak marketing
 * prospects into every auth/listing/payment query. `userId` links a prospect to the User they
 * eventually become, which is the only way to attribute a signup back to outreach spend. */
model OutreachContact {
  id                String         @id @default(cuid())
  name              String
  phone             String?
  /** E.164 (+91XXXXXXXXXX), derived from `phone` on write. Dedupe and suppression key off this,
   * never the raw string — the same number arrives formatted a dozen different ways. */
  phoneE164         String?
  email             String?
  address           String?
  lat               Float?
  lng               Float?
  /** Reuses the existing City/Area geography so campaigns can target "agents in Pune" with the
   * same vocabulary the listing side already uses, instead of substring-matching `address`. */
  cityId            String?
  city              City?          @relation(fields: [cityId], references: [id])
  areaId            String?
  area              Area?          @relation(fields: [areaId], references: [id])

  googleRating      Float?
  googleReviewCount Int?
  /** Ratings drift, so a bare rating with no as-of date is unreadable months later. */
  googleRatingAt    DateTime?
  /** The natural dedupe key for anything Maps-sourced — unique so re-running a scrape upserts
   * instead of duplicating the same business. */
  googlePlaceId     String?        @unique
  /** e.g. "real_estate_agency" — the primary targeting dimension alongside city. */
  businessCategory  String?
  website           String?

  source            ContactSource
  /** The query/URL/filename that produced this row, so a bad import can be traced and undone. */
  sourceRef         String?
  status            ContactStatus  @default(new)
  tags              String[]       @default([])
  notes             String?

  consentState      ConsentState   @default(none)
  consentSource     String?
  consentAt         DateTime?
  optedOutAt        DateTime?

  /** Denormalized from CampaignSend for list views and the "don't contact more often than every
   * N days" check — CampaignSend stays the audit trail. Same pattern as Listing.boostedUntil
   * vs ListingBoost. */
  lastContactedAt   DateTime?
  contactedCount    Int            @default(0)

  /** Set once a prospect signs up — the link between outreach and a real user. */
  userId            String?        @unique
  user              User?          @relation(fields: [userId], references: [id])

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sends             CampaignSend[]

  @@index([cityId, businessCategory])
  @@index([phoneE164])
  @@index([status])
}

/** A promotional campaign. The audience is stored as a *filter*, not a frozen contact list, so a
 * recurring campaign automatically picks up contacts imported after it was created. */
model OutreachCampaign {
  id                  String           @id @default(cuid())
  name                String
  channel             OutreachChannel
  status              CampaignStatus   @default(draft)
  /** Body with {{name}}/{{city}} placeholders, resolved per contact at send time. */
  bodyTemplate        String
  subject             String?
  /** DLT-registered template id. Indian marketing SMS/WhatsApp is rejected without one (see
   * Msg91Provider's note), so activation refuses to proceed if this is missing on sms/whatsapp. */
  dltTemplateId       String?
  /** { cityIds, businessCategories, tags, minRating, status } — resolved by OutreachService. */
  audienceFilter      Json             @default("{}")
  /** Cron expression for a recurring campaign; null means one-shot at scheduledAt. */
  cadenceCron         String?
  scheduledAt         DateTime?
  lastRunAt           DateTime?
  /** Guard rails against burning an entire audience on a bad template. */
  maxSendsPerRun      Int              @default(200)
  minDaysBetweenSends Int              @default(14)
  /** When true the runner records what it *would* have sent without calling the provider —
   * the default, so a new campaign can never blast real messages on its first tick. */
  dryRun              Boolean          @default(true)
  createdById         String
  createdBy           User             @relation(fields: [createdById], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  sends               CampaignSend[]

  @@index([status, scheduledAt])
}

/** One row per contact per campaign run — the audit trail answering "who was sent what, when".
 * Suppressed/opted-out contacts get a row too (rather than being silently skipped) so a campaign
 * report can explain the gap between audience size and messages actually delivered. */
model CampaignSend {
  id            String           @id @default(cuid())
  campaignId    String
  campaign      OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId     String
  contact       OutreachContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel       OutreachChannel
  status        SendStatus       @default(queued)
  /** Identifies one scheduled run of a recurring campaign (e.g. "2026-07-30", or "once"). Part
   * of the unique key below, which is what makes a crashed/retried run idempotent — the same
   * guarantee ListingNotificationLog gets from @@unique([listingId, kind]). */
  runKey        String
  /** Provider message id, for reconciling delivery webhooks back to this row. */
  providerRef   String?
  /** The body actually sent, after placeholder resolution — kept for audit/disputes. */
  renderedBody  String
  sentAt        DateTime?
  deliveredAt   DateTime?
  failureReason String?
  createdAt     DateTime         @default(now())

  @@unique([campaignId, contactId, runKey])
  @@index([contactId, sentAt])
  @@index([campaignId, status])
}

/** Opt-out keyed on the phone/email itself rather than on a contact row, so it survives the
 * contact being deleted and re-imported by a later scrape — without this, the next Google Maps
 * pull would resurrect someone who unsubscribed and start messaging them again. */
model SuppressionEntry {
  id        String           @id @default(cuid())
  /** phoneE164 or lowercased email. */
  value     String           @unique
  channel   OutreachChannel?
  reason    String
  createdAt DateTime         @default(now())
}

/** Contact Us form submissions — see docs/plans/contact-us-support-form.md.
 *
 * Persisted before the notification email is attempted, deliberately: EmailProvider.send() logs
 * and returns on failure rather than throwing, which is right for moderation notifications but
 * would silently lose a user's only copy of a bug report. */
enum ContactTopic {
  posting
  subscription
  account
  listing_report
  website
  other
}

model SupportTicket {
  id          String              @id @default(cuid())
  topic       ContactTopic
  name        String
  email       String
  phone       String?
  listingUrl  String?
  paymentId   String?
  message     String              @db.Text
  /** Set when the form was submitted while logged in; null for anonymous reports (which is the
   * whole point of leaving the endpoint public — "I can't log in" is one of the topics). */
  userId      String?
  user        User?               @relation(fields: [userId], references: [id])
  emailSent   Boolean             @default(false)
  userAgent   String?
  /** Hashed, never the raw address — enough to correlate abuse from one source without holding
   * personal data we have no reason to keep. */
  ipHash      String?
  attachments SupportAttachment[]
  createdAt   DateTime            @default(now())

  @@index([createdAt])
  @@index([topic])
}

model SupportAttachment {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /** R2 object key. Never served publicly — the CDN fronts this bucket, so linking these would
   * turn an anonymous upload endpoint into public file hosting. Support receives the files as
   * email attachments instead; this copy is the durable record. */
  r2Key     String
  filename  String
  mimeType  String
  bytes     Int
  createdAt DateTime      @default(now())

  @@index([ticketId])
}
