# Copy to .env on the EC2 host, fill in real values, then:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d --build

# Caddy — your real domains, DNS A records must point at this instance first
SITE_DOMAIN=www.bhavano.example.com
API_DOMAIN=api.bhavano.example.com
# Bare apex — Caddy 308-redirects this to SITE_DOMAIN rather than serving it directly
APEX_DOMAIN=bhavano.example.com
# Admin moderation app — keep this off any public link/nav; only admins should know it exists
ADMIN_DOMAIN=admin.bhavano.example.com
# Grafana (logging/observability) — same idea as ADMIN_DOMAIN, not linked from public nav
LOGS_DOMAIN=logs.bhavano.example.com

# RDS Postgres endpoint (not a container — see recommendation to keep the DB managed/separate)
DATABASE_URL="postgresql://bhavano:CHANGE_ME@your-rds-endpoint.rds.amazonaws.com:5432/bhavano"

# Web
NEXT_PUBLIC_BFF_URL="https://api.bhavano.example.com"
NEXT_PUBLIC_SITE_URL="https://bhavano.example.com"
# Google Tag Manager container ID — leave blank to skip loading GTM entirely (e.g. locally).
NEXT_PUBLIC_GTM_ID=
# Google Maps JavaScript API + Places — the posting flow's map pin-picker (see
# docs/plans/google-maps-location-picker.md). Sent to the browser, so restrict it by HTTP
# referrer (your domain) in Google Cloud Console — never reuse GOOGLE_MAPS_SERVER_KEY below here.
NEXT_PUBLIC_GOOGLE_MAPS_JS_KEY=
NEXTAUTH_URL="https://bhavano.example.com"
NEXTAUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
AUTH_TRUST_HOST=true

# Admin app — separate NextAuth session from the public site (different secret/cookie),
# same BFF login endpoints under the hood.
ADMIN_NEXTAUTH_URL="https://admin.bhavano.example.com"
ADMIN_NEXTAUTH_SECRET="CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_STRING"

# BFF
AUTH_JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_ID=

# No admin signup flow exists — a phone/email matching one of these (comma-separated) gets
# promoted to role=admin automatically on login. Set these before anyone logs in as admin.
ADMIN_PHONES=
ADMIN_EMAILS=

# Notifications sent to a listing's owner when an admin flags/approves it, and the first-login
# welcome message — all optional, left blank just logs instead of sending (see
# apps/bff/src/notifications).
# Outbound email via Zoho Mail SMTP (bhavano.com's MX and SPF already point at Zoho, so this
# needs no DNS changes). SMTP_PASS must be a Zoho **app-specific password** — Zoho Mail ->
# Settings -> Security -> App Passwords — not the account password, which Zoho rejects for SMTP
# whenever 2FA is on. Leave blank to skip sending entirely (the default locally, which just logs).
# SMTP_HOST is data-centre specific: smtp.zoho.com (global), smtp.zoho.in (India), smtp.zoho.eu.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bhavano <support@bhavano.com>"
# Requires a DLT-registered template in the MSG91 dashboard (India regulation — arbitrary SMS
# content isn't deliverable without one) with a single variable slot (VAR1) for the message body.
MSG91_TRANSACTIONAL_TEMPLATE_ID=
# MSG91 WhatsApp Business API — the first-time-mobile-signup welcome and the ad-posted
# confirmation (see docs/plans/whatsapp-welcome-mobile-signups.md); every other WhatsApp send
# still goes through Meta's Cloud API below. Requires a registered WhatsApp sender number and an
# approved message template in the MSG91 dashboard — Msg91Provider.sendWhatsappTemplate/
# sendAdPostedConfirmation log and no-op rather than failing while these are unset. Each
# template's own NAMESPACE is on its "Code" snippet in the MSG91 dashboard (Templates -> the
# template -> Code) — trust that over any generic docs example, and do not assume it's shared
# across templates: it was originally assumed account-level and shared, but ad-posted's template
# (recreated as "listing_posted" to add a location field) was issued a different namespace than
# welcome's despite using the same integrated number, so each template gets its own NAMESPACE var
# below. INTEGRATED_NUMBER is the one value actually shared by both.
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_WHATSAPP_NAMESPACE=
MSG91_WHATSAPP_TEMPLATE_NAME=
MSG91_WHATSAPP_AD_POSTED_TEMPLATE_NAME=
MSG91_WHATSAPP_AD_POSTED_NAMESPACE=
# "Verify your listing" — sent to a scraped PG/coworking business's phone asking them to claim
# their bulk-imported listing (see ListingsService.claimListing, bulk_upload_listings.py). Same
# INTEGRATED_NUMBER as above, its own NAMESPACE per the note above.
MSG91_WHATSAPP_CLAIM_TEMPLATE_NAME=
MSG91_WHATSAPP_CLAIM_NAMESPACE=
# Validates inbound MSG91 WhatsApp delivery/read status webhooks (see
# WhatsappWebhookController) — MSG91 doesn't sign these calls the way Razorpay's webhook is
# HMAC-signed, so this secret in the URL path is what stands in for that. Set this, then
# configure the exact same value into MSG91's dashboard webhook URL:
# https://<API_DOMAIN>/webhooks/msg91-whatsapp-status/<this value>. Unset means the endpoint
# rejects every call with 403 rather than accepting an unauthenticated one.
MSG91_WEBHOOK_SECRET=

# Photo storage — Cloudflare R2 (S3-compatible) + a custom-domain CDN in front of it.
# See "Photo storage (Cloudflare R2 + CDN)" in docs/deployment.md for how to create these.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
CDN_BASE_URL="https://cdn.bhavano.example.com"
# Lets the bff purge a specific photo URL from Cloudflare's edge cache the moment an admin rotates
# it — see docs/plans/listing-photo-orientation.md. Without these, a rotated photo's public URL
# (not the admin panel's own view, which cache-busts itself) can keep serving the pre-rotation
# bytes for up to Cloudflare's default cache TTL. Create the token at Cloudflare dashboard → My
# Profile → API Tokens → Create Token → "Zone.Cache Purge" template, scoped to this zone; the zone
# ID is on the domain's Overview page. Entirely optional — without them, rotating still works and
# updates R2 correctly, the public URL just catches up on its own once the cache expires.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Shared (both web's NextAuth Google provider and bff's /auth/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Grafana admin login — see "Logging & observability (Loki + Grafana)" in docs/deployment.md
GRAFANA_ADMIN_PASSWORD="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# Razorpay — listing boosts, see docs/plans/monetization-boosted-listings-premium-tiers.md.
# Use live-mode keys here; RAZORPAY_KEY_SECRET/WEBHOOK_SECRET never reach the client.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Maps — server-side reverse geocoding for the map pin-picker (see
# docs/plans/google-maps-location-picker.md). IP-restrict this in Google Cloud Console
# (Geocoding API only); it must never be sent to any client — separate from
# NEXT_PUBLIC_GOOGLE_MAPS_JS_KEY above and from GOOGLE_CLIENT_ID/SECRET (Google OAuth login).
GOOGLE_MAPS_SERVER_KEY=

# MaxMind GeoLite2 — best-effort city/region/country label on each Visit row, from its IP, shown
# only in the admin panel (see docs/plans/visit-ip-city-logging.md). Free key from
# https://www.maxmind.com/en/geolite2/signup. Used only by scripts/update-geolite.sh, which
# downloads the database to ./data/geoip; the bff reads the file, never this key.
# Entirely optional — without it, every visit's ipCity/ipRegion/ipCountry just stays null.
MAXMIND_LICENSE_KEY=

# WhatsApp Business — Meta Cloud API, called directly (not through MSG91). See
# docs/plans/post-ad-acknowledgement.md.
#
# WHATSAPP_PHONE_NUMBER_ID is the *phone number* id from the WhatsApp > API Setup page, NOT the
# WhatsApp Business Account (WABA) id shown next to it. Using the WABA id here is the most common
# cause of a 400 on send.
#
# WHATSAPP_ACCESS_TOKEN must be a System User token from Business Settings, with
# whatsapp_business_messaging + whatsapp_business_management. The token offered on the app
# dashboard is temporary and expires within about a day — fine for a curl test, useless in prod.
#
# Templates must be approved by Meta before they can be sent, and business-initiated messages can
# only ever be templates. Leaving these unset disables WhatsApp: sends log and skip.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WELCOME_TEMPLATE=
# Sent instead of email when a poster has no email on file — see NotificationsService.
# notifyListingPosted and docs/plans/post-ad-acknowledgement.md. Must be the approved template's
# exact name (created via whatsapp_create_listing_posted_template.py) and must have a dynamic URL
# button — an approved template with no button, or a static one, would silently drop the link.
WHATSAPP_LISTING_POSTED_TEMPLATE=
# Not read by the app — only by whatsapp_test_send.py, which uses it to list the phone numbers
# and approved templates on the account so the id above can be confirmed rather than guessed.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Optional overrides — defaults are v23.0 and "en".
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=

# ---------------------------------------------------------------------------------------------
# Google Ads / Tag Manager tooling. Mostly the repo-root *.py scripts (run from a dev machine,
# not the server) — but as of docs/plans/server-side-google-ads-conversion-upload.md,
# GOOGLE_ADS_CLIENT_ID/_SECRET/_REFRESH_TOKEN (not the developer token — Data Manager API doesn't
# use one) are ALSO read by the bff container in production (docker-compose.prod.yml), to upload
# New registration/Post ad success conversions directly to Google Ads server-side via the Data
# Manager API. GOOGLE_ADS_REFRESH_TOKEN must include the datamanager scope for that to work, not
# just adwords — see the plan doc's manual prerequisites; a token minted before that scope was
# added will 401 on ingest calls specifically (the root ads_*.py scripts are unaffected either
# way, since they only ever needed the adwords scope). The rest of this section
# (GOOGLE_ADS_DEVELOPER_TOKEN, GOOGLE_ADS_CUSTOMER_ID, GOOGLE_ADS_LOGIN_CUSTOMER_ID,
# GTM_REFRESH_TOKEN) is still repo-root-scripts-only and safe to leave blank in a normal deploy.
# These drive ads_setup_conversions.py / ads_report.py (Google Ads API) and gtm_audit.py /
# gtm_build.py (Tag Manager API — the Enhanced Conversions setup, see
# docs/plans/consolidate-analytics-and-ads-on-gtm.md).
#
# All the OAuth pieces share ONE "Desktop app" OAuth client in Google Cloud project 268317873723
# (APIs & Services → Credentials). Different scripts just mint their own refresh token against it:
#   get_refresh_token.py      → GOOGLE_ADS_REFRESH_TOKEN  (Google Ads API + Data Manager API scopes)
#   get_gtm_refresh_token.py  → GTM_REFRESH_TOKEN         (Tag Manager + read-only GA4 scopes)
# Enable the "Google Ads API", "Data Manager API", "Tag Manager API" and "Google Analytics Admin
# API" on that same project first, or a minted token still 403s on every call.

# From the Google Ads API Center (one per Ads manager account). Root scripts only.
GOOGLE_ADS_DEVELOPER_TOKEN=
# The shared Desktop OAuth client's id + secret. Also read by the bff container.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Minted by get_refresh_token.py. Grants the Google Ads API + Data Manager API scopes. Also read
# by the bff container.
GOOGLE_ADS_REFRESH_TOKEN=
# The Ads account being operated on, digits only (e.g. "421-406-6478" → 4214066478).
GOOGLE_ADS_CUSTOMER_ID=
# Only if the login reaches GOOGLE_ADS_CUSTOMER_ID *through* a manager (MCC) account — set it to
# that manager's id (digits only). Leave blank when the login hits the account directly;
# ads_setup_conversions.py drops the header automatically if it's an MCC it can't reach anyway.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Minted by get_gtm_refresh_token.py. Grants the Tag Manager (readonly + edit + publish) and
# read-only GA4 Admin scopes. The account signing in needs Publish rights on container
# GTM-N46D868W.
GTM_REFRESH_TOKEN=
