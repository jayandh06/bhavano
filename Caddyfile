# HSTS: tell browsers to use HTTPS only for a year. No includeSubDomains/preload on purpose — those
# are close to irreversible, and api/admin/logs are separate hosts that can opt in on their own once
# this has run cleanly. Set on the apex redirect too, so a first visit to bhavano.com is covered.
(hsts) {
	header Strict-Transport-Security "max-age=31536000"
}

{$SITE_DOMAIN} {
	import hsts
	reverse_proxy web:3000
}

# Bare apex domain redirects to the canonical www host rather than serving its own copy.
{$APEX_DOMAIN} {
	import hsts
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$API_DOMAIN} {
	# reverse_proxy handles the socket.io WebSocket upgrade transparently — no special config needed.
	# Slightly above MAX_VIDEO_BYTES (200MB, packages/types/src/videoLimits.ts) — rejects an
	# oversized video upload at the edge with a 413 instead of streaming the whole thing into the
	# bff container first, where multer would reject it anyway.
	request_body {
		max_size 210MB
	}
	reverse_proxy bff:4000
}

# Admin moderation app — separate host so it's never reachable via the public site's domain.
{$ADMIN_DOMAIN} {
	reverse_proxy admin:3001
}

# Grafana — logging/observability dashboard, admin-auth-protected, not linked from public nav.
{$LOGS_DOMAIN} {
	reverse_proxy grafana:3000
}
