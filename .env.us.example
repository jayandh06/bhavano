# The US host's .env (copy to .env there). Every value is the US stack's own: a different database, secrets, photo bucket and keys from India's.
# Setup steps: docs/plans/us-stack-setup.md.

# --- Names (DNS A records to the US host) ---
# Where India's Caddy sends www.bhavano.com/us/*. Visitors never use this name directly.
US_ORIGIN_DOMAIN=us-origin.bhavano.com
# The US API, the NEXT_PUBLIC_BFF_URL of the US web image.
US_API_DOMAIN=api.us.bhavano.com
# X-Robots-Tag sent on every US response. Leave as is until the US launches, then set to "all" (and flip `indexable` for the US in packages/types/src/market.ts).
US_ROBOTS_TAG="noindex, nofollow"

# --- Database: the US DB instance's PRIVATE IP and its own role and password (never India's). Same shape as India's DATABASE_URL. ---
DATABASE_URL=postgresql://bhavano:CHANGE_ME@10.0.0.10:5432/bhavano

# --- Secrets (generate new ones; never reuse India's) ---
AUTH_JWT_SECRET=
NEXTAUTH_SECRET=

# --- Web (must match the US_NEXT_PUBLIC_* repository variables the image was built with) ---
NEXT_PUBLIC_BFF_URL=https://api.us.bhavano.com
NEXT_PUBLIC_SITE_URL=https://www.bhavano.com/us
# The US sign-in route under the shared host.
NEXTAUTH_URL=https://www.bhavano.com/us/api/auth

# --- Sign-in and email (US OAuth clients / SMTP account) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
APPLE_BUNDLE_ID=
ADMIN_EMAILS=
ADMIN_PHONES=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Photos (a separate US bucket and CDN host) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
CDN_BASE_URL=

# --- Maps (server key; the browser key is the US_NEXT_PUBLIC_GOOGLE_MAPS_JS_KEY build variable) ---
GOOGLE_MAPS_SERVER_KEY=

# --- Optional ---
EXPO_PUSH_ENABLED=
EXPO_ACCESS_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_LISTING_COPY_PROVIDER=
GEMINI_MODEL=
