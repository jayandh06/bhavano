// Grafana Alloy config — tails the BFF's rotating log files (written to a Docker volume shared
// with the bff container, see docker-compose.prod.yml) and ships them into Loki.
//
// Promtail (the older, simpler log shipper) is in maintenance mode — Grafana recommends Alloy,
// their unified collector, for any new setup. This does the same job: tail files, parse JSON,
// push to Loki. See docs/plans/bff-loki-grafana-logging.md for the full design.

local.file_match "bff_logs" {
  path_targets = [
    {"__path__" = "/var/log/bff/*.log", "job" = "bff"},
  ]
}

loki.source.file "bff" {
  targets    = local.file_match.bff_logs.targets
  forward_to = [loki.process.bff.receiver]
}

loki.process "bff" {
  forward_to = [loki.write.default.receiver]

  // Only promote low-cardinality fields to real Loki labels — userId/ip/url/reqId stay in the
  // JSON body, queried with `| json | field="value"` in Grafana. A label per user would blow up
  // Loki's index; this is the one rule that matters most for it to stay fast and cheap.
  //
  // `provider` is the one addition beyond the original design (see
  // docs/plans/third-party-api-call-audit-logging.md) — a handful of fixed values
  // ("google-maps", "whatsapp-meta", "msg91", "google-ads"), stamped only on the structured
  // third-party-call log lines `thirdPartyCallLogger.ts` emits, absent from every other log line
  // (which is fine — an absent label just doesn't match a `{provider="..."}` selector). Cheap to
  // index for the same reason `level`/`service` are, and it's the fast first filter for "show me
  // every MSG91 call" before narrowing further with `| json`.
  //
  // `app` (see docs/plans/client-error-reporting-loki-grafana.md) is the same kind of addition —
  // exactly three fixed values ("web", "admin", "mobile"), stamped only on `client_error` log
  // lines (`clientErrorLogger.ts`), absent everywhere else. Distinct from `service`, which is
  // always "bff" here: `app` says which *client* crashed, not which backend service logged it.
  stage.json {
    expressions = {
      level    = "level",
      service  = "service",
      provider = "provider",
      app      = "app",
    }
  }

  stage.labels {
    values = {
      level    = "",
      service  = "",
      provider = "",
      app      = "",
    }
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
